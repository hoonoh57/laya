# true = 모의투자(mockapi.kiwoom.com), false = 실전투자(api.kiwoom.com)
TRADING_MOCK=true

# 키움 REST API - 모의투자용 앱키 (실전과 별도 발급)
KIWOOM_MOCK_APPKEY=
KIWOOM_MOCK_SECRETKEY=
KIWOOM_MOCK_ACCOUNT=

# 키움 REST API - 실전투자용 앱키 (포털에 접속 IP 등록 필요)
KIWOOM_REAL_APPKEY=
KIWOOM_REAL_SECRETKEY=
KIWOOM_REAL_ACCOUNT=

# Cybos Plus 32비트 파이썬
CYBOS_PYTHON=E:\Python310-32\python.exe

SERVER_HOST=127.0.0.1
SERVER_PORT=8755
BRIDGE_PORT=8801
